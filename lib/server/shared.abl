fun to_string(raw_value, raw_fallback):
    if type(raw_value) == "UNDEFINED" or raw_value == null:
        return raw_fallback
    if type(raw_value) == "STRING":
        if raw_value == "":
            return raw_fallback
        return raw_value
    text_value = str(raw_value)
    if text_value == "":
        return raw_fallback
    return text_value

fun normalize_path(path_value):
    return to_string(path_value, "/")

fun join_path(base_value, segment_value):
    normalized_base = normalize_path(base_value)
    normalized_segment = normalize_path(segment_value)
    if normalized_base == "/":
        if normalized_segment == "/" or normalized_segment == "":
            return "/"
        return normalized_segment
    if normalized_segment == "/" or normalized_segment == "":
        return normalized_base
    return normalized_base + normalized_segment

fun is_callable(call_value):
    t = type(call_value)
    return t == "FUNCTION" or t == "BOUND_METHOD"

fun to_list(list_value):
    if type(list_value) == "LIST":
        return list_value
    items = []
    if type(list_value) == "UNDEFINED" or list_value == null:
        return items
    items.append(list_value)
    return items

fun clone_object(obj_value):
    if type(obj_value) == "OBJECT":
        return dict(obj_value)
    return {}
