from path import to_string, normalize, join

fun normalize_path(path_value):
    return normalize(path_value)

fun join_path(base_value, segment_value):
    return join(base_value, segment_value)

fun is_callable(call_value):
    t = type(call_value)
    return t == "FUNCTION" or t == "BOUND_METHOD"

fun to_list(list_value):
    if type(list_value) == "LIST":
        return list_value
    items = []
    if type(list_value) == "UNDEFINED" or list_value == null:
        return items
    items.append(list_value)
    return items

fun clone_object(obj_value):
    if type(obj_value) == "OBJECT":
        return dict(obj_value)
    return {}
