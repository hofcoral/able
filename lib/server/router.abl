from server.annotations import get_base_path, get_routes, get_middleware
from server.shared import to_string, is_callable, normalize_path, join_path

_ALLOWED_METHODS = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]

fun _is_allowed_method(router_method_value):
    for allowed of _ALLOWED_METHODS:
        if allowed == router_method_value:
            return true
    return false

fun _bind_handler(instance, handler_fn):
    fun bound(request):
        return handler_fn(instance, request)
    return bound

fun _resolve_handler(instance, handler_value):
    if not is_callable(handler_value):
        return null
    if type(handler_value) == "FUNCTION":
        return _bind_handler(instance, handler_value)
    return handler_value


fun _clone_list(entries_list):
    cloned = []
    if type(entries_list) == "LIST":
        for entry of entries_list:
            cloned.append(entry)
    return cloned

fun _collect_middleware_entries(target):
    collected = []
    middleware_entries = get_middleware(target)
    if type(middleware_entries) == "LIST":
        for entry of middleware_entries:
            if not is_callable(entry):
                continue
            collected.append(entry)
    return collected

fun _normalize_method(method_value):
    return to_string(method_value, "")

fun _create_route_key(route_method_value, route_path_value):
    return _normalize_method(route_method_value) + " " + route_path_value

fun _build_error(error_kind, error_method, error_path, error_handler):
    error_entry = {}
    error_entry.type = error_kind
    error_entry.method = error_method
    error_entry.path = error_path
    error_entry.handler = error_handler
    return error_entry

fun _build_route_record(controller_cls, instance, base_path, router_entry_item, controller_middleware):
    router_result = {}
    router_result.record = null
    router_result.error = null
    router_method_value = router_entry_item.verb
    if type(router_method_value) == "UNDEFINED" or router_method_value == null:
        router_method_value = router_entry_item.method
    if type(router_method_value) == "UNDEFINED" or router_method_value == null:
        router_method_value = ""
    router_path_value = router_entry_item.path
    if type(router_path_value) == "UNDEFINED" or router_path_value == null:
        router_path_value = "/"
    router_joined_path = join_path(base_path, router_path_value)
    if router_method_value == "":
        router_result.error = _build_error("missing_method", router_method_value, router_joined_path, router_entry_item.handler)
        return router_result
    router_method_value = _normalize_method(router_method_value)
    if not _is_allowed_method(router_method_value):
        router_result.error = _build_error("invalid_method", router_method_value, router_joined_path, router_entry_item.handler)
        return router_result
    router_handler_value = _resolve_handler(instance, router_entry_item.handler)
    if router_handler_value == null:
        router_result.error = _build_error("invalid_handler", router_method_value, router_joined_path, router_entry_item.handler)
        return router_result
    router_middleware = _collect_middleware_entries(router_entry_item.handler)
    router_record = {}
    router_record.method = router_method_value
    router_record.path = router_joined_path
    router_record.key = _create_route_key(router_record.method, router_record.path)
    router_record.handler = router_handler_value
    router_record.action = router_entry_item.handler
    router_record.controller = instance
    router_record.controller_class = controller_cls
    router_record.controller_middleware = _clone_list(controller_middleware)
    router_record.route_middleware = router_middleware
    router_result.record = router_record
    return router_result

fun build_routes_with_errors(router_registry):
    router_routes = []
    router_errors = []
    if type(router_registry) == "LIST":
        for controller_entry of router_registry:
            if type(controller_entry) == "TYPE":
                controller_instance = controller_entry()
                base_path_value = normalize_path(get_base_path(controller_entry))
                route_defs = get_routes(controller_entry)
                controller_middleware = _collect_middleware_entries(controller_entry)
                if type(route_defs) == "LIST":
                    for route_item of route_defs:
                        record_result = _build_route_record(controller_entry, controller_instance, base_path_value, route_item, controller_middleware)
                        if not (record_result.record == null):
                            router_routes.append(record_result.record)
                        if not (record_result.error == null):
                            router_errors.append(record_result.error)
    router_result = {}
    router_result.routes = router_routes
    router_result.errors = router_errors
    return router_result

fun build_routes(router_registry):
    router_result = build_routes_with_errors(router_registry)
    return router_result.routes

fun build_route_index(router_routes):
    router_index = {}
    router_entries = []
    if type(router_routes) == "LIST":
        for route_entry of router_routes:
            router_index_entry = {}
            router_index_entry.key = route_entry.key
            router_index_entry.method = route_entry.method
            router_index_entry.path = route_entry.path
            router_index_entry.route = route_entry
            router_entries.append(router_index_entry)
    router_index.entries = router_entries
    return router_index

fun find_route(router_index, method_value, path_value):
    if type(router_index) == "OBJECT":
        router_entries = router_index.entries
        if type(router_entries) == "LIST":
            router_key = _create_route_key(method_value, to_string(path_value, "/"))
            for router_entry of router_entries:
                if router_entry.key == router_key:
                    return router_entry.route
    return null

fun create_router(router_registry):
    router_result = build_routes_with_errors(router_registry)
    router_routes = router_result.routes
    router_index = build_route_index(router_routes)
    router_ctx = {}
    router_ctx.routes = router_routes
    router_ctx.index = router_index
    router_ctx.errors = router_result.errors

    fun match(method_value, path_value):
        return find_route(router_index, method_value, path_value)

    router_ctx.match = match
    return router_ctx
