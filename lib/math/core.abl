fun add(a, b):
    if not (a is Number) or not (b is Number):
        return null
    return a + b

fun sqrt(x):
    if not (x is Number):
        return null
    if x < 0:
        return null
    return x.sqrt()

fun floor(x):
    if not (x is Number):
        return null
    return x.floor()

fun ceil(x):
    if not (x is Number):
        return null
    return x.ceil()

fun round(x):
    if not (x is Number):
        return null
    return x.round()
